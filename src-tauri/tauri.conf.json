{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Agent MCR",
  "version": "0.1.0",
  "identifier": "cc.lambdahouse.agent-mcr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent MCR",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: localfile: http://localfile.localhost https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Agent Mission Control Room",
    "longDescription": "A local harness for coding-agent sessions: their terminals, how they depend on each other, and what waits on you.",
    "category": "Productivity",
    "copyright": "© 2026 Lambda House",
    "fileAssociations": [],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMjIyRTc3RTlFQ0REQzUKUldURjNlenBkeTRpTUpzdHVycVJyZ0V0VHlkM3dQdllYaEZhTXc4cUVRb0Rxblc3V2FhMVVDV3cK",
      "endpoints": [
        "https://github.com/lambda-house/agent-mcr/releases/latest/download/latest.json"
      ]
    }
  }
}
